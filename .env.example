# ==============================================================================
# Variables de Entorno del Cliente (Expo / React Native / PWA)
# ==============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ==============================================================================
# Variables de Entorno de Backend (Supabase Edge Functions Secrets)
# Configurar con: supabase secrets set --env-file .env.ai.local --project-ref TU_PROYECTO
# ==============================================================================
GEMINI_API_KEY=tu-gemini-api-key-aqui
# Clave opcional de respaldo / failover automático si se agota la primera:
GEMINI_API_KEY_FALLBACK=
# Otra clave de Google: las claves del mismo proyecto comparten cuotas.
GEMINI_API_KEY_ADDITIONAL=
GEMINI_MODEL=gemini-3.5-flash-lite
# Voz en vivo: habilitar únicamente con proyecto gratuito confirmado en AI Studio.
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_ENABLED=false
COACH_LIVE_SIGNING_SECRET=
# Coach IA: configurar ambos valores solo en Supabase Edge Functions Secrets.
GROQ_API_KEY=tu-groq-api-key-aqui
GROQ_COACH_MODEL=openai/gpt-oss-120b
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# Solo servidor: nunca usar EXPO_PUBLIC_USDA_API_KEY.
USDA_API_KEY=tu-usda-api-key-aqui

# ==============================================================================
# Referencias de Proyecto Supabase (Desarrollo y CI/CD)
# ==============================================================================
SUPABASE_PROJECT_REF=tu-project-ref
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
