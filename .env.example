# ==============================================================================
# Variables de Entorno del Cliente (Expo / React Native / PWA)
# ==============================================================================
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ==============================================================================
# Variables de Entorno de Backend (Supabase Edge Functions Secrets)
# Configurar con: npx supabase secrets set GEMINI_API_KEY=...
# ==============================================================================
GEMINI_API_KEY=tu-gemini-api-key-aqui
# Clave opcional de respaldo / failover automático si se agota la primera:
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=tu-openai-api-key-aqui
# Solo servidor: nunca usar EXPO_PUBLIC_USDA_API_KEY.
USDA_API_KEY=tu-usda-api-key-aqui

# ==============================================================================
# Referencias de Proyecto Supabase (Desarrollo y CI/CD)
# ==============================================================================
SUPABASE_PROJECT_REF=tu-project-ref
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
