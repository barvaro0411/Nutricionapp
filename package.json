    "@zxing/library": "^0.23.0",
    "expo": "~52.0.25",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.14",
    "expo-constants": "~17.0.5",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
